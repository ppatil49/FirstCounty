# Copy this file to .env and fill in ONE provider. .env is git-ignored; never commit keys.

# Which AI to use: gemini | ollama | openai | azure_openai | replay
#   replay = no API key; uses saved AI responses for the 12 sample ads (eval/results/replay_cache)
LLM_PROVIDER=replay

# Optional: override the default model for the provider
#   gemini default: gemini-3.6-flash   ollama default: qwen2.5:7b   openai default: gpt-4.1
# LLM_MODEL=

# --- Google Gemini (free tier key from https://aistudio.google.com) ---
# GEMINI_API_KEY=

# --- Ollama (free, runs on this machine; install from https://ollama.com, then `ollama pull qwen2.5:7b`) ---
# LLM_BASE_URL=http://localhost:11434/v1/

# --- OpenAI ---
# OPENAI_API_KEY=

# --- Azure OpenAI (production target) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Findings below this confidence are flagged "needs human judgment"
LOW_CONFIDENCE_THRESHOLD=0.6

# Database (SQLite file by default; any SQLAlchemy URL works, e.g. Azure SQL / Postgres)
# DATABASE_URL=sqlite:///var/fcb.db

# Save every live AI response so it can be replayed without a key
RECORD_REPLAY=true
